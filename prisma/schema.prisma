generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Complaint {
  id            Int       @id @default(autoincrement())
  requestId     String    @unique
  telegramId    String
  role          String
  viloyat       String
  tuman         String?
  schoolInn     String?
  schoolName    String
  category      String
  subcategory   String
  description   String
  contact       String?
  priority      String    @default("medium")
  status        String    @default("new")
  adminComment  String?
  beforeFileId  String?
  afterFileId   String?
  resolvedAt    DateTime?
  daysToResolve Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}
