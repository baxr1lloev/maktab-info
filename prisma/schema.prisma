generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Complaint {
  id            Int       @id @default(autoincrement())
  requestId     String    @unique
  telegramId    String
  userId        Int?
  user          User?     @relation(fields: [userId], references: [id])
  role          String
  viloyat       String
  tuman         String?
  schoolInn     String?
  schoolName    String
  category      String
  subcategory   String
  description   String
  contact       String?
  priority      String    @default("medium")
  status        String    @default("new")
  adminComment  String?
  beforeFileId  String?
  afterFileId   String?
  resolvedAt    DateTime?
  daysToResolve Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model User {
  id           Int        @id @default(autoincrement())
  telegramId   String     @unique
  username     String?
  firstName    String?
  balance      Int        @default(0)
  trustCredits Int        @default(3)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  complaints   Complaint[]
  purchases    Purchase[]
}

model ShopItem {
  id          Int        @id @default(autoincrement())
  title       String     @unique
  description String?
  price       Int
  type        String
  value       String
  stock       Int        @default(-1)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  purchases   Purchase[]
}

model Purchase {
  id        Int      @id @default(autoincrement())
  userId    Int
  itemId    Int
  user      User     @relation(fields: [userId], references: [id])
  item      ShopItem @relation(fields: [itemId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([itemId])
}
